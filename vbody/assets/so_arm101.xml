<mujoco model="so_arm101_kinematics">
  <!--
    Kinematic chain of the SO-ARM100/101 (five controlled joints, base to
    wrist). Derived from the TheRobotStudio / trs_so_arm100 MuJoCo model;
    see LICENSE.model (Apache 2.0) in this directory.

    Trimmed for vBody: link frames, joints and inertials only. Visual and
    collision meshes, actuators, contacts and keyframes are removed - forward
    kinematics reads body offsets and joint axes, nothing else. Body offsets,
    quaternions and joint axes are byte-identical to the source model, so the
    tool point this file produces is the same one the full model produces.

    The last body, Fixed_Jaw, is the wrist link. Its frame origin lies on the
    wrist-roll axis; --camera-offset is measured from that origin, in this
    frame. The midpoint between the jaw pads sits at (0, -0.09, 0.01) m here.
  -->
  <compiler angle="radian"/>

  <worldbody>
    <body name="Base">
      <body name="Rotation_Pitch" pos="0 -0.0452 0.0165" quat="0.707105 0.707108 0 0">
        <inertial pos="-9.07886e-05 0.0590972 0.031089" quat="0.363978 0.441169 -0.623108 0.533504" mass="0.119226"
          diaginertia="5.94278e-05 5.89975e-05 3.13712e-05"/>
        <joint name="Rotation" axis="0 1 0" range="-1.92 1.92"/>
        <body name="Upper_Arm" pos="0 0.1025 0.0306" euler="1.57079 0 0">
          <inertial pos="-1.72052e-05 0.0701802 0.00310545" quat="0.50104 0.498994 -0.493562 0.50632" mass="0.162409"
            diaginertia="0.000213312 0.000167164 7.01522e-05"/>
          <joint name="Pitch" axis="1 0 0" range="-3.32 0.174"/>
          <body name="Lower_Arm" pos="0 0.11257 0.028" euler="-1.57079 0 0">
            <inertial pos="-0.00339604 0.00137796 0.0768007" quat="0.701995 0.0787996 0.0645626 0.704859"
              mass="0.147968" diaginertia="0.000138803 0.000107748 4.84242e-05"/>
            <joint name="Elbow" axis="1 0 0" range="-0.174 3.14"/>
            <body name="Wrist_Pitch_Roll" pos="0 0.0052 0.1349" euler="-1.57079 0 0">
              <inertial pos="-0.00852653 -0.0352279 -2.34622e-05" quat="-0.0522806 0.705235 0.0549524 0.704905"
                mass="0.0661321" diaginertia="3.45403e-05 2.39041e-05 1.94704e-05"/>
